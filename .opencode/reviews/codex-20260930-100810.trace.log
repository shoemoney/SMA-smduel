    return { ok: true, player: { ...player, inVehicle: false } };
  }
  if (!isVehicleInRange(player.position, vehiclePosition)) {
    return { ok: false, reason: 'outOfRange' };
  }
  return { ok: true, player: { ...player, inVehicle: true } };
