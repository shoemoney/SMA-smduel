    const { sceneView, post } = writePostFrame(gpuCtx, resources, ARENA_GRADE, nowSeconds);
    encodeGradedFrame(
      gpuCtx.getDevice(),
      resources.pipeline,
      post,
      sceneView,
      gpuCtx.getContext().getCurrentTexture().createView(),
      resources.cameraBindGroup,
