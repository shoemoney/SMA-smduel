/*
 * Combat HUD overlay styles.
 *
 * ALL colour/type/space values come from tokens.css — this file declares no
 * colour of its own. `--hud-scale` is NOT a design token: hud.ts writes it
 * inline onto the overlay root from HudSettings.scale, so it is a runtime
 * input, and it is declared here only as the fallback for markup that has not
 * gone through hud.ts. Same for the per-element `--hud-radar-x/y` and
 * `--hud-speed-frac` custom properties hud.ts sets.
 *
 * - Positioning: upper-left weapons, upper-centre message feed, upper-right
 *   condition, lower-left radar, bottom-centre speed, lower-right a11y.
 * - No state is ever conveyed by colour alone: every damage/status element
 *   carries a `data-state` attribute and its own text/glyph content (see
 *   hud.ts); the state colours below are a redundant reinforcement layer, not
 *   the only signal.
 * - `data-reduced-flash`/`data-reduced-shake` on the root disable the
 *   corresponding animations.
 * - The four generic `[data-state]` rules are scoped to `.hud-root`. They used
 *   to be bare global attribute selectors, so any element anywhere in the page
 *   carrying `data-state="critical"` had its text colour changed by the HUD's
 *   stylesheet.
 * - NO REGRESSION TEST GUARDS THIS FILE'S LAYOUT: happy-dom computes no
 *   layout (getBoundingClientRect() answers zero) and evaluates no media
 *   queries, so panel sizing is verified by opening the game — the same
 *   measured limitation menu.css and builder.css document.
 */

@import './tokens.css';

.hud-root {
  --hud-scale: 1;

  /* Token x scale, resolved once. --hud-scale is written inline by hud.ts, so
     every dimension below multiplies it through these locals instead of
     repeating a long calc() in forty rules. */
  --pad: calc(var(--ui-space-4) * var(--hud-scale));
  --gap: calc(var(--ui-space-3) * var(--hud-scale));
  --inset: calc(var(--ui-space-5) * var(--hud-scale));
  --t2xs: calc(var(--ui-text-2xs) * var(--hud-scale));
  --txs: calc(var(--ui-text-xs) * var(--hud-scale));
  --tbase: calc(var(--ui-text-base) * var(--hud-scale));
  --tdisplay: calc(var(--ui-text-display) * var(--hud-scale));
  --rsm: calc(var(--ui-radius-sm) * var(--hud-scale));
  --rlg: calc(var(--ui-radius-lg) * var(--hud-scale));
  --rule: calc(1px * var(--hud-scale));

  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 20;
  color: var(--ui-ink);
  font-family: var(--ui-font-mono);
  font-size: var(--tbase);
  line-height: var(--ui-leading-tight);
  /* Inherited by the whole overlay so every number in a column lines up. */
  font-variant-numeric: tabular-nums;
  -webkit-font-smoothing: antialiased;
}

/* --- panel chrome: one shared shell so the six panels read as one cluster --- */

.hud-panel {
  position: absolute;
  pointer-events: auto;
  padding: var(--pad) var(--inset);
  max-width: calc(260px * var(--hud-scale));
  background: linear-gradient(180deg, var(--ui-glass-raised), var(--ui-glass) 68%);
  border: 1px solid var(--ui-line);
  border-radius: var(--rlg);
  box-shadow: var(--ui-shadow-panel);
  backdrop-filter: blur(6px);
}

/* Titles sit at the BOTTOM of the ramp — a player reads the value, not the
   label, so the label is the smallest and quietest thing in the panel. */
.hud-panel-title {
  margin: 0 0 var(--gap);
  color: var(--ui-ink-dim);
  font-size: var(--t2xs);
  font-weight: var(--ui-weight-semibold);
  letter-spacing: var(--ui-tracking-wider);
  text-transform: uppercase;
}

/* Screen-reader-only content: visually hidden, still in the accessibility tree. */
.hud-visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* --- layout slots ----------------------------------------------------- */

/* The Arcade home link owns the top-left corner on EVERY screen — it is
   `position: fixed; top: 8px; min-height: 44px` in tokens.css, living outside
   #app so it survives every screen mount. This panel was pinned to the same
   corner, and `.hud-root` is `z-index: 20` against the link's 10, so WEAPONS
   both PAINTED OVER the one control that leaves a run in one key and
   RECEIVED POINTER EVENTS at its centre.
   That is the same failure iteration 71 recorded for the arena's exit button
   behind the CONDITION panel, with a different pair of elements, and it is why
   the fix is a reserved SLOT rather than a z-index bump: raising the link above
   the panel would leave the panel's own top edge hidden underneath it, and any
   future panel in that corner would collide again.
   The reserved height is deliberately NOT scaled by --hud-scale: the link is
   plain fixed chrome, so a scaled reservation would be wrong on small viewports
   and leave the overlap in exactly the case where the link is largest.

   And it is a literal rather than a custom property, after two attempts to
   abstract it failed to resolve: a first pass wrote `.hud-nav-reserved: 52px`,
   which is a SELECTOR and not an assignment, and a second declared
   `--hud-nav-reserved` at the top level where the computed value on the root
   element came back EMPTY — so `calc()` with it was invalid, `top` silently
   fell back to `auto`, and the panel sat at y=0 exactly as before. Both
   failures produced no error and no visual change, which is the iteration-32
   shape precisely: a declaration that resolves to nothing looks identical to a
   declaration that was never written. Verified by hit-testing, not by looking.
   One honest number, in one place, is worth more here than a name. */
.hud-panel--weapons {
  top: calc(var(--inset) + 52px);
  left: var(--inset);
}

.hud-panel--radar {
  bottom: var(--inset);
  left: var(--inset);
  width: calc(180px * var(--hud-scale));
}

.hud-panel--speed {
  bottom: var(--inset);
  left: 50%;
  transform: translateX(-50%);
  text-align: center;
  min-width: calc(132px * var(--hud-scale));
}

/* The CONDITION panel, offset DOWN to clear the exit button.
 *
 * `src/app.ts` mounts the arena's "Exit to title" and the road's "Leave arena"
 * at `top: 8px; right: 8px`, and this panel was ALSO at `top: var(--inset);
 * right: var(--inset)` — the same corner. The HUD host paints after the button,
 * so the panel covered it completely: in the arena and road captures the only
 * trace of the button was the top-right sliver of its teal border peeking out
 * from behind this panel, which reads as a clipped empty widget rather than as
 * a control.
 *
 * That is worse than a cosmetic overlap. "Exit" is the way out of a run, it was
 * invisible, and it was unclickable — and seventy reviews had gone past it,
 * because a button hidden BEHIND a panel is not an element any of them was
 * looking for. The arena and road are the only screens that mount this panel
 * (the city carries the car strip from iteration 28 instead), so offsetting it
 * is scoped to exactly the two screens that need the corner.
 *
 * The button is ~29px tall at scale 1, so 34px clears it with a little air and
 * keeps the panel's top edge aligned with the other panels' inset rhythm. */
.hud-panel--damage {
  top: calc(var(--inset) + 34px);
  right: var(--inset);
}

/**
 * Message feed.
 *
 * Offset BELOW the top inset rather than on it. The arena and road screens also
 * render their own status line — a `position:absolute; top:8px; left:50%`
 * element built in `src/app.ts` — and both it and this panel were claiming
 * top-centre, so the feed printed straight over the status line and neither was
 * readable. The screens' status line is the one that carries the controls
 * legend, so the feed yields and sits under it.
 */
/* An empty message feed draws no box — see buildMessageFeed. */
[data-empty='true'].hud-panel--messages {
  display: none;
}

.hud-panel--messages {
  /* Clears the screens' own top status banner, which is a `top: 8px` element
   * built in src/app.ts. 26px was enough to stop them overlapping but left the
   * log flush against the banner's bottom edge with no breathing room, which
   * still reads as one collided block. A vision review of the real frame
   * described them as "overlapping directly" and "causing text collision" —
   * the honest read was "touching", but the fix is the same: give them a real
   * gap. 44px clears the 8px offset, the banner's own height and its padding. */
  top: calc(var(--inset) + 44px);
  left: 50%;
  transform: translateX(-50%);
  width: min(calc(420px * var(--hud-scale)), 62vw);
}

/* The accessibility panel hides itself when neither reduction is active.
 *
 * A chip that reads "off" occupies a corner carrying radar, telemetry and the
 * speedometer on every frame of every run, in order to report a null. Only the
 * ACTIVE reduction is rendered — see `buildAccessibilityControls`, where the
 * same `data-empty` mechanism the message feed already uses does this job. The
 * keyboard toggles are unaffected either way. */
[data-empty='true'].hud-panel--a11y {
  display: none;
}

.hud-panel--a11y {
  right: var(--inset);
  bottom: var(--inset);
  display: flex;
  flex-direction: column;
  gap: var(--gap);
}

